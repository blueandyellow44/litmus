# Secrets — never commit
.env
.env.*
!.env.example
*.rtf
LITMUS secret*

# Dependencies / build output
node_modules/
dist/
*.tsbuildinfo

# Baked snapshot (regenerated by the daily funnel)
litmus-client/src/demo/snapshot.json
# Written by scripts/check-edition-size.mjs at publish time.
litmus-client/public/edition-size.json

# Calibration runs and their rendered review pages. Same reason as the snapshot
# above: both embed full article rawText, and reproducing source text is exactly
# what the excerpt policy keeps out of this repo. The scorer code and the harness
# are committed; their output is local and regenerable with `npm run calibrate`.
calibration-runs/
calibration-review/

# Local embedded Postgres data + scratch
pgdata*/
*.log

.DS_Store

# Local pre-edit snapshots taken before in-place edits (ROE: preserve prior state).
.backups/

# Agent-tool project memory, per-checkout and not part of the product.
.claude/
docs/run-failures/*.log
